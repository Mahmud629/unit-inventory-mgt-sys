# Copy this file to .env.local and change the values.
# .env.local is never committed to git.

# Login for the inventory system
INVENTORY_USERNAME=admin
INVENTORY_PASSWORD=change-me-to-a-strong-password

# Optional: secret used to sign login sessions (any long random text).
# If not set, it is derived from the username and password above, so
# changing the password logs everyone out.
# SESSION_SECRET=

# Optional: store the database somewhere else (default: data/inventory.db)
# INVENTORY_DB_PATH=D:\InventoryData\inventory.db
